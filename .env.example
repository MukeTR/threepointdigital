# Three Point Digital — ortam değişkenleri örneği
#
# Bu dosyayı sunucuda `.env` adıyla kopyalayıp değerleri doldurun:
#   cp .env.example .env && nano .env
#
# .env dosyası git'e girmez ve web'den erişilemez (sunucu 404 döndürür).
# hPanel > Node.js uygulaması ekranından girilen değişkenler önceliklidir;
# .env yalnızca orada tanımlı olmayanları tamamlar.
#
# Değişiklikten sonra uygulamayı yeniden başlatın.

# --- Supabase ---------------------------------------------------------------
# Project Settings > API bölümünden alınır. service_role anahtarı gizlidir,
# yalnızca sunucuda durur, tarayıcıya hiç gönderilmez.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# --- Yönetim paneli (/admin) ------------------------------------------------
# Şifrenin kendisi değil, sha256 özeti saklanır. Özeti şöyle üretin:
#   node -e "console.log(require('crypto').createHash('sha256').update('ŞİFRENİZ').digest('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Oturum çerezinin imza anahtarı. Boş bırakılırsa şifreden türetilir.
# Rastgele üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- İletişim formu ---------------------------------------------------------
# Form bildirimlerinin gideceği adres (FormSubmit üzerinden).
CONTACT_EMAIL=info@threepointdigital.com
